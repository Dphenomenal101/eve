# Next.js (demo has no provider access)
EVE_ENABLE_DEMO_MODE=true
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set these on the Convex deployment, not NEXT_PUBLIC_ variables.
# npx convex env set NAME value
# SITE_URL=http://localhost:3000
# BETTER_AUTH_SECRET=<32+ random bytes>
# EVE_ENCRYPTION_KEY=<base64-encoded 32 random bytes>
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# AUTH_EMAIL_API_KEY=<Resend key for authentication emails only>
# AUTH_EMAIL_FROM=Eve <login@yourdomain.com>
# COMPOSIO_API_KEY=
# COMPOSIO_HUBSPOT_AUTH_CONFIG_ID=
# AI_GATEWAY_API_KEY=
# EVE_MODEL=<supported-provider/model-id>
# Customer AgentMail, Retell, and Context credentials are entered in Connections.
